PORT=3003
REQUEST_BODY_LIMIT=10mb

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=biker_db
DB_SSL=false

# WARNING: change in production
JWT_SECRET=change-me
JWT_ISSUER=biker-backend
JWT_AUDIENCE=biker-app
JWT_TTL_SECONDS=3600

# Optional
TYPEORM_SYNC=false
TYPEORM_LOGGING=false
SEED_DEFAULTS=true
SEED_OVERWRITE=false

REDIS_URL=redis://localhost:6379

DRIVER_SEARCH_RADIUS_KM=5
DRIVER_LOCK_TTL_SECONDS=30

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT=biker-backend/1.0

# OSRM Configuration (for routing - replaces Google Maps)
OSRM_HOST=http://router.project-osrm.org
# Production: Use your own OSRM server instance

GPS_MAX_SPEED_MPS=55
GPS_MAX_ACCURACY_M=200

# Payment Gateways (optional)
# STRIPE_SECRET_KEY=sk_test_xxx
# PAYPAL_CLIENT_ID=xxx
